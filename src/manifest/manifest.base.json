{
  "manifest_version": 3,
  "name": "Polemica Notes",
  "version": "8.1.72",
  "description": "Заметки об игроках, статистика, цветные ники и удобные мелочи для Polemica Game: пауза, мьют, разбор матчей.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://*.polemicagame.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.github.com ws://localhost:* wss://localhost:*"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "conn-diag-page.js"
      ],
      "matches": [
        "https://*.polemicagame.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.polemicagame.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "notes.css"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_icon": "icon16.png",
    "default_popup": "popup.html"
  }
}
