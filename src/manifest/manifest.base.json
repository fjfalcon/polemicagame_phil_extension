{
  "manifest_version": 3,
  "name": "Polemica Notes",
  "version": "8.1.37",
  "description": "Расширение для Polemica Game с дополнительными функциями:\n• Статистика игроков\n• Подмена роли (F)\n• Быстрая пауза (F8)\n• Автопринятие игры",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.polemicagame.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://localhost:* wss://localhost:*"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.polemicagame.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "notes.css"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_icon": "icon16.png",
    "default_popup": "popup.html"
  }
}
