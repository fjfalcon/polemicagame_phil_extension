{
  "name": "polemica-notes",
  "version": "9.5.0",
  "private": true,
  "description": "Расширение для Polemica Game: статистика, заметки, OBS, Twitch",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist .dist-js",
    "build:js": "tsup",
    "assemble:chrome": "node scripts/assemble.mjs chrome",
    "assemble:firefox": "node scripts/assemble.mjs firefox",
    "build:chrome": "npm run build:js && npm run assemble:chrome",
    "build:firefox": "npm run build:js && npm run assemble:firefox",
    "build": "npm run clean && npm run build:js && npm run assemble:chrome && npm run assemble:firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint:ext:chrome": "web-ext lint -s dist/chrome",
    "lint:ext:firefox": "web-ext lint -s dist/firefox",
    "dev:firefox": "web-ext run -s dist/firefox",
    "sign:firefox": "web-ext sign -s dist/firefox -a dist/signed --channel unlisted",
    "release:assets": "node scripts/release-assets.mjs",
    "chrome:auth": "node scripts/chrome-auth.mjs",
    "publish:chrome": "node scripts/publish-chrome.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/node": "^26.1.2",
    "@types/webextension-polyfill": "^0.12.5",
    "fast-check": "^4.9.0",
    "fast-glob": "^3.3.3",
    "jsdom": "^30.0.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.6",
    "web-ext": "^8.3.0"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  }
}
