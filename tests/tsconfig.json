{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "chrome", "vitest/globals", "vitest/jsdom"],
    "paths": {
      "@core/*": ["src/core/*"],
      "@shared/*": ["src/shared/*"],
      "@content/*": ["src/content/*"]
    },
    "noEmit": true
  },
  "include": ["./**/*.ts", "../vitest*.config.ts", "../src/**/*.ts"]
}
